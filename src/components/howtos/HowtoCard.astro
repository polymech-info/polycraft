---
import { Img } from "imagetools/components";
import { translate } from "@polymech/astro-base/base/i18n.js";
import { decode } from "html-entities";
const  I18N_SOURCE_LANGUAGE = 'en'
import Translate from "@polymech/astro-base/components/i18n.astro";
import type { IHowto } from "@/model/howto/howto.js";

export interface Props {
  title: string;
  url: string;
  author?: string;
  description: string;
  image?: string;
  alt?: string;
  tags?: string[];
  category?: string;
  difficulty_level?: string;
  time?: string;
  total_views?: number;
  total_downloads?: number;
  locale?: string;
  howto: IHowto;
}

const { 
  title, 
  url, 
  author, 
  description, 
  image, 
  alt, 
  tags = [], 
  category,
  difficulty_level,
  time,
  total_views,
  total_downloads,
  locale,
  howto
} = Astro.props;

// Translate title, description, and author
const currentLocale = locale || Astro.currentLocale;
const translatedTitle = await translate(title, I18N_SOURCE_LANGUAGE, currentLocale);
const fullDescription = await translate(description, I18N_SOURCE_LANGUAGE, currentLocale);
const translatedDescription = fullDescription.length > 150 ? fullDescription.substring(0, 150) + '...' : fullDescription;
const translatedAuthor = author ? await translate(author, I18N_SOURCE_LANGUAGE, currentLocale) : '';

// Use the cover image from howto if available
const displayImage = howto.cover_image?.src || image || "https://picsum.photos/640/360";
const displayAlt = alt || translatedTitle;

// Check if image is external URL (imagetools can't process external URLs at build time)
const isExternalImage = displayImage.startsWith('http://') || displayImage.startsWith('https://');
const useImagetools = !isExternalImage;

// Format category for display
const displayCategory = category || 'Uncategorized';

// Decode HTML entities in time field - handle translation cache issues
const decodedTime = time ? decode(time) : '';
const cleanTime = decodedTime.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');

// The URL prop already points to the correct howto page
const cardUrl = url;

---

<article class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 border border-gray-100 flex flex-col h-full">
  <a href={cardUrl} class="block aspect-[16/9] overflow-hidden bg-gray-100 relative">
    {useImagetools ? (
      <!-- Use imagetools for local images -->
      <Img 
        src={displayImage} 
        alt={displayAlt}
        width={480}
        height={320}
        format="avif"
        placeholder="blurred"
        objectFit="cover"
        loading="lazy"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        attributes={{
          img: { 
            class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          }
        }}
      />
    ) : (
      <!-- Use regular img for external URLs with error handling -->
      <div class="image-container w-full h-full">
        <img 
          src={displayImage}
          alt={displayAlt}
          class="primary-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          style="aspect-ratio: 3/2;"
          loading="lazy"
          onerror={`
            this.style.display='none'; 
            this.nextElementSibling.style.display='block';
          `}
        />
        <img 
          src="https://picsum.photos/640/360"
          alt={displayAlt}
          class="fallback-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          style="display: none;"
          loading="lazy"
        />
      </div>
    )}
  </a>
  
  <div class="p-4 flex flex-col flex-1">
    <!-- 1. Category / Title / Author - Compact Section -->
    <div class="mb-2">
      <!-- Category - Compact -->
      {category && (
        <div class="mb-1 flex items-center">
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a.997.997 0 01-1.414 0l-7-7A1.997 1.997 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          <a 
            href={`/${currentLocale}/howto-category/${category.toLowerCase().replace(/\s+/g, '-')}`}
            class="text-orange-600 hover:text-orange-800 hover:underline transition-colors relative z-10 text-sm"
            onclick="event.stopPropagation();"
          >
            <Translate>{displayCategory}</Translate>
          </a>
        </div>
      )}
      
      <!-- Title - Compact 2 lines max -->
      <h3 class="font-semibold text-gray-900 group-hover:text-orange-600 transition-colors duration-200 line-clamp-2 mb-1">
        <a href={cardUrl} class="stretched-link hover:no-underline">
          <Translate>{translatedTitle}</Translate>
        </a>
      </h3>
      
      <!-- Author - Compact -->
      {translatedAuthor && translatedAuthor.toLowerCase() !== 'unknown' && (
        <p class="text-xs text-gray-500">
          <Translate>By</Translate> {translatedAuthor}
        </p>
      )}
    </div>
    
    <!-- 2. Description - Truncated -->
    <div class="mb-2">
      <p class="text-gray-600 text-sm leading-5">
        {translatedDescription}
      </p>
    </div>
    
    <!-- 3. Bottom section - Meta + Stats -->
    <div class="mt-auto">
      <!-- Metadata badges - Above stats -->
      <div class="mb-2 h-6 flex items-start">
        <div class="flex flex-wrap gap-1">
          {difficulty_level && (
            <span class="px-2 py-0.5 tiny-text bg-blue-100 text-blue-800 rounded">
              <Translate>{difficulty_level}</Translate>
            </span>
          )}
          {cleanTime && (
            <span class="px-2 py-0.5 tiny-text bg-green-100 text-green-800 rounded">
              {cleanTime}
            </span>
          )}
        </div>
      </div>
      
      <!-- Stats row -->
      <div class="pt-2 border-t border-gray-200">
      <div class="grid grid-cols-2 gap-2 text-xs text-gray-500">
        {total_views !== undefined && (
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
            {total_views}
          </span>
        )}
        {total_downloads !== undefined && (
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {total_downloads}
          </span>
        )}
      </div>
      </div>
    </div>
  </div>
</article>

<style>
  .stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: "";
  }
  
  /* Image error handling */
  .image-container {
    position: relative;
  }
  
  .fallback-image {
    position: absolute;
    top: 0;
    left: 0;
  }
  
  /* Extra small text for metadata */
  .tiny-text {
    font-size: 0.75rem; /* 12px */
    line-height: 1.2;
  }
</style>

